startup {
	vars.thisGordo = new Dictionary<int, string> {
		{0x5, "Pink Gordo (Main)"},
		{0x8, "Pink Gordo (Ring Island)"},
		{0xB, "Phosphor Gordo"},
		{0x6, "Tabby Gordo (Reef)"},
		{0x2, "Tabby Gordo (Beach)"},
		{0xA, "Honey Gordo"},
		{0x4, "Hunter Gordo"},
		{0x1, "Rock Gordo (Cave)"},
		{0x7, "Rock Gordo (Ash Isle)"},
		{0xC, "Rad Gordo"},
		{0x9, "Crystal Gordo"},
		{0x3, "Quantum Gordo"},
		{0xE, "Boom Gordo"},
		{0x0, "Mosaic Gordo"},
		{0xD, "Tangle Gordo"},
		{0xF, "Dervish Gordo"}
	};

	settings.Add("gordoSplit", true, "Split when popping a Gordo (Adventure/Casual mode only)");
	settings.Add("gateSplit", false, "Split when using a key on a gate");
	settings.Add("teleportSplit", true, "Split when warping home using a teleporter");
	settings.Add("returnSplit", true, "Split after Emergency Returning");
	settings.Add("suppressHoneyReturn", true, "Suppress Emergency Return split when near Honey Gordo. Uncheck this if using honey hover route.", "returnSplit");
	settings.Add("ruinsSplit", true, "Split when entering the Ancient Ruins for the first time");
	settings.Add("desertSplit", false, "Split when teleporting to the Glass Desert");

	foreach (var g in vars.thisGordo)
		settings.Add(g.Value, true, g.Value, "gordoSplit");
}

init {
	// MD5 code by CptBrian.
	string MD5Hash;
	using (var md5 = System.Security.Cryptography.MD5.Create())
		using (var s = File.Open(modules.First().FileName, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
			MD5Hash = md5.ComputeHash(s).Select(x => x.ToString("X")).Aggregate((a, b) => a + b);
	print("MD5Hash: " + MD5Hash);

	int gordoOffset = 0;
	switch(MD5Hash) {
		case "D7C5A3D642348A1C4661C69B51971D"  : version = "1.4.1c"; gordoOffset = 0x163AF50; break;
		case "A82CBDAD4AA16341D436FF8F24788DC7": version = "1.4.2"; gordoOffset = 0x168EEA0; break;
		case "2A7939BF3AB02090C36BD8BDA037E9E2": version = "1.4.3b"; gordoOffset = 0x17C5508; break;
		case "2E1E312AF04AC4E661319536E01BE05F": version = "1.4.4"; gordoOffset = 0x17E1BD8; break;
		default: version = "Undetected!"; break;
	}

	vars.gordoWatchers = new MemoryWatcherList();
	for (int i = 0; i <= 0xF; ++i) {
		var ptr = new DeepPointer("UnityPlayer.dll", gordoOffset, 0x8, 0x170, 0x28, 0x40, 0x88, 0x30, 0x18, 0x30 + i * 0x18, 0x20);
		vars.gordoWatchers.Add(new MemoryWatcher<int>(ptr) {Name = vars.thisGordo[i]});
	}
}

start {
	return
		old.worldTime < current.worldTime &&
		current.worldTime >= 32402 &&
		current.worldTime < 32410;
}

onStart {
	vars.hasEnteredRuins = false;
	vars.isInRuins = false;
	vars.wasAwayFromHome = false;
	vars.invalidReturn = false;
} 

update {
	//print("playerX: " + current.playerX);
	//print("playerY: " + current.playerY);
	//print("playerZ: " + current.playerZ);
	//print("wasAwayFromHome: " + vars.wasAwayFromHome);
	//52.83 15.21566 -132.74 home teleport location
	//89.29 [y] -144.46 death teleport location

	// 528 ruins trigger Z
	// -30 ruins x lower bound
	// 150 ruins x upper bound 

	// death planes:
	// - slime sea ~ -9.8 y
	// - desert ~ 990 y

	// honey gordo zone:
	// x : -456 - -430
	// z :  373 - 396
}

split {
	// prevents erroneous splits in main menu/during loading
	if (current.worldTime < 32400) 
		return false;

	// If not rush mode, check for gordo split
	if (settings["gordoSplit"] && current.gameMode != 3) {
		vars.gordoWatchers.UpdateAll(game);

		for (int i = 0; i <= 0xF; ++i) {
			string name = vars.thisGordo[i];
			if (settings[name] && vars.gordoWatchers[name].Changed) {
				int eatOld = vars.gordoWatchers[name].Old;
				int eatCurr = vars.gordoWatchers[name].Current;
				return eatOld > 0 && eatCurr == -1;
			}
		}
	}
	
	if (settings["returnSplit"] || settings["teleportSplit"]) {
		vars.wasAwayFromHome = old.playerX < 0 || old.playerX > 100 || old.playerZ > -100 || old.playerY > 50; // rough approximation of how we can be confident the player was somewhere else before teleporting home. checking Y pos is really to check for glass desert
	}

	if(settings["returnSplit"]) {
		vars.invalidReturn = 
			old.health < 1 && current.health >= 100f || //died by health?
			old.playerY < -9.5 || //died by slime sea?
			old.playerY > 970 && old.playerY < 992 || //died by desert sea?
			settings["suppressHoneyReturn"] && old.playerX > -456 && old.playerX < -430 && old.playerZ > 373 && old.playerZ < 396; //emergency return from honey gordo, suppress if setting is checked
	}

	if (settings["ruinsSplit"]) {
		vars.isInRuins = current.region == 0 && current.playerX > -30 && current.playerX < 150 && current.playerZ > 528;
	}

	return 
		old.readyForCredits && !current.readyForCredits ||
		settings["gateSplit"] && old.keys > current.keys ||
		settings["desertSplit"] && old.region == 0 && current.region == 1 ||
		settings["returnSplit"] && vars.wasAwayFromHome && !vars.invalidReturn && current.playerX > 89.28 && current.playerX < 89.30 && current.playerZ > -144.47 && current.playerZ < -144.45 ||
		settings["teleportSplit"] && vars.wasAwayFromHome  && current.playerX > 52.80 && current.playerX < 52.86 && current.playerZ > -132.77 && current.playerZ < -132.71 ||
		settings["ruinsSplit"] && vars.isInRuins && !vars.hasEnteredRuins && (vars.hasEnteredRuins = true);
}

